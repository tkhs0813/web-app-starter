# App
ORIGIN="http://localhost:5173"

# Turso / libSQL
# Cloudflare production example: libsql://your-db-org.turso.io
# Local development example: file:local.db
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret"

# Transactional email
# console = log emails in local dev; replace with resend/postmark/sendgrid in src/lib/server/app/email.ts
EMAIL_PROVIDER="console"
EMAIL_FROM="Web App Starter <hello@example.com>"

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_LOOKUP_KEY="starter_pro_monthly"
STRIPE_TEAM_PRICE_LOOKUP_KEY="starter_team_monthly"
